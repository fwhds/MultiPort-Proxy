{
  "name": "multiport-proxy",
  "version": "0.2.0",
  "private": true,
  "workspaces": ["apps/web", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @multiport/web",
    "prebuild": "node scripts/ensure-linux-bindings.mjs",
    "build": "npm run build -w @multiport/web",
    "typecheck": "npm run typecheck -w @multiport/core && npm run typecheck -w @multiport/web",
    "test": "npm test -w @multiport/core",
    "package:deploy": "node scripts/package-deliverables.mjs",
    "deploy": "npm run deploy:cloudflare",
    "deploy:cloudflare": "npm exec -w @multiport/web wrangler -- deploy --config ../../wrangler.jsonc",
    "preview:cloudflare": "npm exec -w @multiport/web wrangler -- versions upload --config ../../wrangler.jsonc"
  }
}
